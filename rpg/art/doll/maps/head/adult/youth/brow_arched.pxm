# head/adult/youth/brow_arched: the youth's arched brows
# P2b FACES (wave 2): GENERATED from the adult maps by the FACES spec (the boy = the man's views, the girl = the
# woman's as `when girl replace`); edit the adult maps, then regenerate. Format: rpg/art/doll/doll.h.
use person
body youth
role brow arched
layer face
anchor head
keys rest
tags mirror-ok

view D key rest origin -3 -7
|.bb....bb.
|b........b

view U key rest origin 0 0
|.

view R key rest origin -11 -7
|bb.
|..b

view L key rest origin -2 -7
|.bb
|b..

view D key rest origin -4 -7 when boy,elf replace
|bb....bb

view R key rest origin -11 -7 when boy,elf replace
|bb

view L key rest origin -3 -7 when boy,elf replace
|bc

view D key rest origin -4 -7 when girl,elf replace
|b......b
|.b....b.

view R key rest origin -11 -7 when girl,elf replace
|b.
|.b

view L key rest origin -3 -7 when girl,elf replace
|.b
|b.

view D key rest origin -4 -8 when girl replace
|bb....bb

view U key rest origin 0 0 when girl replace
|.

view R key rest origin -11 -8 when girl replace
|b

view L key rest origin -4 -8 when girl replace
|b
