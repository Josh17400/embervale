# head/adult/youth/nose_straight: the youth's straight nose
# P2b FACES (wave 2): GENERATED from the adult maps by the FACES spec (the boy = the man's views, the girl = the
# woman's as `when girl replace`); edit the adult maps, then regenerate. Format: rpg/art/doll/doll.h.
use person
body youth
role nose straight
layer face
anchor head
keys rest

view D key rest origin -8 -10
|r
|r

view U key rest origin 0 0
|.

view R key rest origin -14 -10
|sq
|rq

view L key rest origin 0 -10
|qt
|qs

view D key rest origin -7 -10 when boy,elf replace
|t.
|.r

view R key rest origin -14 -10 when boy,elf replace
|sq

view L key rest origin 0 -10 when boy,elf replace
|qt

view D key rest origin -7 -10 when girl,elf replace
|t.
|.r

view D key rest origin -8 -10 when girl replace
|s
|r

view U key rest origin 0 0 when girl replace
|.

view R key rest origin -14 -9 when girl replace
|s
|sq

view L key rest origin 0 -9 when girl replace
|.t
|qs
