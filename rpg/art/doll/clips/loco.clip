f armL=oidle armR=guard held=guard legs=walkD neck=rest sheath=drawn torso=rest tuft=up plant=0:-3
clip walk R part action family sword variant 1
f hang=wide armL=- armR=guard held=guard hilt=- legs=walkA neck=flow sheath=rest torso=run bob=1 plant=3:0
f hang=wide armL=- armR=guard held=guard hilt=- legs=walkA2 neck=flow2 sheath=rest torso=run hair=swing tuft=down plant=0:-4
