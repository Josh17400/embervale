# ---- Pray (DOLL-C, P2c wave 2 round 2): at the temples and shrines (posesOf gives it to every youth; drawn on v1 before).
#      The youth's arms have no `pray` view: the hands meet before the chest on `hold`, the head bowed a row, eyes closed.
clip idle D posture pray
f armL=hold armR=hold legs=idle torso=rest hang=rest head=0,1 expr=closed
f armL=hold armR=hold legs=idle torso=rest hang=rest head=0,1 bob=-1 expr=closed
clip idle U posture pray
f armL=hold armR=hold legs=idle torso=rest hang=rest head=0,1
f armL=hold armR=hold legs=idle torso=rest hang=rest head=0,1 bob=-1
clip idle R posture pray
f armL=- armR=hold legs=idle torso=rest hang=rest head=1,1 expr=closed
f armL=- armR=hold legs=idle torso=rest hang=rest head=1,1 bob=-1 expr=closed
clip idle L posture pray
f armL=hold armR=- legs=idle torso=rest hang=rest head=-1,1 expr=closed
f armL=hold armR=- legs=idle torso=rest hang=rest head=-1,1 bob=-1 expr=closed
