# rpg/art/doll/clips/kin_child.clip: the child's LOCO, DEATH and posture clips (KIN-CHILD, P2b wave 2; first drawn in the
# slice by FOLK-BODY). Format: rpg/art/doll/doll.h. The child is 21 px (STYLE_P2 3); the walk's planted foot steps 2 / 2 / 2 px
# (a 12 px cycle); kids never run on the RUN part (they run with the Play posture's frames: tag, hopping). The side walk,
# the motion rebuild (2026-10-21, docs/MOTION_P2.md 5.5): the plants mark the planted HEEL (R 1:-1, -1:-3, -3:-5; L the
# R's + 1), the same 2 / 2 / 2 advances; the feet are one boot angled through the stride (kin/child/legs/std.pxm).

# (KIN-CHILD rollout, 2026-10-22; docs/P2B_MOTION_ROLLOUT.md 7.7) THE SIDE WALK by the method at 21 px: the near leg
# (legs/std) and the far leg (legs/far) on their own parts; holds 2 / 2 / 2 (plants -1:-3, -3:-5, -5:-7, the same in
# both facings: the L legs are the body's own mirror now); bob +1 on the contacts only (hip=0,-1 keeps the hip and the
# skirts where the legs are: the torso and head sink a pixel onto the landing leg), no hop on the pass; arms B N F
# against the legs (as the adult's); torso=run (the garments' walk hem) on every side walk frame and on the Play and
# Carry side frames (their legs are the walk keys and hop).
body child
anchors D head=-6,-20 neck=0,-10 hip=0,-5 shoulderR=-6,-9 shoulderL=5,-9
anchors U head=-6,-20 neck=0,-10 hip=0,-5 shoulderR=5,-9 shoulderL=-6,-9
anchors R head=-6,-20 neck=0,-10 hip=0,-5 shoulderR=-1,-9 shoulderL=-1,-9
anchors L head=-6,-20 neck=0,-10 hip=0,-5 shoulderR=0,-9 shoulderL=0,-9
# idle: neutral, breathe (the upper body a pixel up), blink
clip idle D
f armL=idle armR=idle legs=idle
f armL=idle armR=idle legs=idle bob=-1
f armL=idle armR=idle legs=idle expr=blink
clip idle U
f armL=idle armR=idle legs=idle
f armL=idle armR=idle legs=idle bob=-1
f armL=idle armR=idle legs=idle
clip idle R
f armL=- armR=N legs=idle
f armL=- armR=N legs=idle bob=-1
f armL=- armR=N legs=idle expr=blink
clip idle L
f armL=N armR=- legs=idle
f armL=N armR=- legs=idle bob=-1
f armL=N armR=- legs=idle expr=blink
# the walk: front and back step in place (a foot lifted a row; the body rises a pixel on the pass); side views plant the
# foot 2 / 2 / 2 px (a 12 px cycle). The hips stay within a pixel of the contact frame's (0 / 0 / -1: the rise on the pass
# shows more leg, never less). A long skirt sways a pixel with the step; tails and braids swing on the down frames
clip walk D
f armL=fwd armR=back legs=walkA sway=-1 plant=3:1
f armL=fwd armR=back legs=idle hair=swing sway=-1 plant=1:-1
f armL=idle armR=idle legs=walkC bob=-1 plant=-1:-3
f armL=back armR=fwd legs=walkC sway=1 plant=3:1
f armL=back armR=fwd legs=idle hair=swing sway=1 plant=1:-1
f armL=idle armR=idle legs=walkA bob=-1 plant=-1:-3
clip walk U
f armL=back armR=fwd legs=walkA sway=-1 plant=3:1
f armL=back armR=fwd legs=idle hair=swing sway=-1 plant=1:-1
f armL=idle armR=idle legs=walkC bob=-1 plant=-1:-3
f armL=fwd armR=back legs=walkC sway=1 plant=3:1
f armL=fwd armR=back legs=idle hair=swing sway=1 plant=1:-1
f armL=idle armR=idle legs=walkA bob=-1 plant=-1:-3
clip walk R
f armL=- armR=B legs=walkA torso=run sway=-1 plant=-1:-3
f armL=- armR=N legs=walkA2 torso=run hair=swing sway=-1 plant=-3:-5
f armL=- armR=F legs=walkB2 torso=run sway=-1 plant=-5:-7
f armL=- armR=F legs=walkC torso=run sway=1 plant=-1:-3
f armL=- armR=N legs=walkC2 torso=run hair=swing sway=1 plant=-3:-5
f armL=- armR=B legs=walkD2 torso=run sway=1 plant=-5:-7
clip walk L
f armR=- armL=B legs=walkA torso=run sway=-1 plant=-1:-3
f armR=- armL=N legs=walkA2 torso=run hair=swing sway=-1 plant=-3:-5
f armR=- armL=F legs=walkB2 torso=run sway=-1 plant=-5:-7
f armR=- armL=F legs=walkC torso=run sway=1 plant=-1:-3
f armR=- armL=N legs=walkC2 torso=run hair=swing sway=1 plant=-3:-5
f armR=- armL=B legs=walkD2 torso=run sway=1 plant=-5:-7
clip hurt D
f armL=idle armR=idle legs=idle expr=hurt bob=-1
clip hurt U
f armL=idle armR=idle legs=idle bob=-1
clip hurt R
f armL=- armR=N legs=idle expr=hurt bob=-1
clip hurt L
f armL=N armR=- legs=idle expr=hurt bob=-1

# the fall: recoil, buckle (the body sinking over the legs), topple (the lying figure in the air); lying: the left view laid down
clip fall D variant 0
f armL=idle armR=idle legs=idle expr=hurt bob=-1 head=0,-1
f armL=idle armR=idle legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=west at=2,-2
clip fall D variant 1
f armL=idle armR=idle legs=idle expr=hurt bob=-1 head=0,-1
f armL=idle armR=idle legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=east at=-2,-2
clip fall U variant 0
f armL=idle armR=idle legs=idle expr=hurt bob=-1 head=0,-1
f armL=idle armR=idle legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=west at=2,-2
clip fall U variant 1
f armL=idle armR=idle legs=idle expr=hurt bob=-1 head=0,-1
f armL=idle armR=idle legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=east at=-2,-2
clip fall R variant 0
f armL=- armR=N legs=idle expr=hurt bob=-1 head=0,-1
f armL=- armR=N legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=west at=2,-2
clip fall R variant 1
f armL=- armR=N legs=idle expr=hurt bob=-1 head=0,-1
f armL=- armR=N legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=east at=-2,-2
clip fall L variant 0
f armL=N armR=- legs=idle expr=hurt bob=-1 head=0,-1
f armL=N armR=- legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=west at=2,-2
clip fall L variant 1
f armL=N armR=- legs=idle expr=hurt bob=-1 head=0,-1
f armL=N armR=- legs=buckle expr=hurt bob=2 head=0,1
f armL=lie armR=- legs=idle expr=closed turn=east at=-2,-2
clip lying L variant 0
f armL=lie armR=- legs=idle expr=closed
clip lying L variant 1
f armL=lie armR=- legs=idle expr=closed

# ---------------------------------------------------------------- the kids' postures (KIN-CHILD; frame counts and paces
# are postureInfo's, art_life.cpp). Leg modes: stand (idle, or the walk keys while striding), hop (tag: off the ground by 2,
# the body with them: bob=-2), sit (a chair: the hips on the seat line 7 rows up, so the body rises 2: bob=-2, the boots
# dangling), cross (cross-legged on the floor: the hips 2 over it, bob=3). The prop in hand is the doll's postureProp at the
# right hand (`held=<key>`, PROPS' maps), as on the adults; facing left the right arm works as the far arm.
clip idle D posture play
f armL=up armR=raise legs=walkA hair=swing
f armL=raise armR=up legs=hop bob=-2
f armL=up armR=raise legs=walkC hair=swing
f armL=raise armR=up legs=hop bob=-2 expr=talk
clip idle U posture play
f armL=up armR=raise legs=walkA hair=swing
f armL=raise armR=up legs=hop bob=-2
f armL=up armR=raise legs=walkC hair=swing
f armL=raise armR=up legs=hop bob=-2
clip idle R posture play
f armL=- armR=up torso=run legs=walkA hair=swing
f armL=- armR=raise torso=run legs=hop bob=-2
f armL=- armR=up torso=run legs=walkC hair=swing
f armL=- armR=raise torso=run legs=hop bob=-2 expr=talk
clip idle L posture play
f armL=up armR=- torso=run legs=walkA hair=swing
f armL=raise armR=- torso=run legs=hop bob=-2
f armL=up armR=- torso=run legs=walkC hair=swing
f armL=raise armR=- torso=run legs=hop bob=-2 expr=talk
clip idle D posture carry
f armL=fwd armR=shoulder held=shoulder legs=walkA
f armL=idle armR=shoulder held=shoulder legs=idle
f armL=back armR=shoulder held=shoulder legs=walkC
f armL=idle armR=shoulder held=shoulder legs=idle
clip idle U posture carry
f armL=back armR=shoulder held=shoulder legs=walkA
f armL=idle armR=shoulder held=shoulder legs=idle
f armL=fwd armR=shoulder held=shoulder legs=walkC
f armL=idle armR=shoulder held=shoulder legs=idle
clip idle R posture carry
f armL=- armR=shoulder held=shoulder torso=run legs=walkA
f armL=- armR=shoulder held=shoulder torso=run legs=walkA2
f armL=- armR=shoulder held=shoulder torso=run legs=walkC
f armL=- armR=shoulder held=shoulder torso=run legs=walkC2
clip idle L posture carry
f armL=B armR=shoulder held=shoulder torso=run legs=walkA
f armL=N armR=shoulder held=shoulder torso=run legs=walkA2
f armL=F armR=shoulder held=shoulder torso=run legs=walkC
f armL=N armR=shoulder held=shoulder torso=run legs=walkC2
