   {
    "at": 2.1,
    "shot": "p2b_doll_t4_2.png"
   },
   {
    "at": 2.2,
    "expect": [
     "state.player.anim.clip == 'idle'",
     "state.player.sprite.part == 'loco'"
    ]
   }
  ]
 },
 {
  "name": "p2b target (B5): the sheathed / drawn pick: Idle variant 1 (drawn) for 4 s after a swing, then variant 0 (sheathed)",
  "params": {
   "rig": 2,
   "hour": 11,
   "god": true
  },
  "steps": [
   {
    "at": 0.2,
    "call": [
     "skill",
     "kit",
     "sword",
     "none"
    ]
   },
   {
    "at": 0.4,
    "expect": [
     "state.player.anim.clip == 'idle'",
     "state.player.anim.variant == 0"
    ]
   },
   {
    "at": 0.5,
    "input": "j@0-0.1"
   },
   {
    "at": 1.6,
    "expect": [
     "state.player.anim.clip == 'idle'",
     "state.player.anim.variant == 1"
    ]
   },
   {
    "at": 5.4,
    "expect": [
     "state.player.anim.clip == 'idle'",
     "state.player.anim.variant == 0"
    ]
   }
  ]
 },
 {
