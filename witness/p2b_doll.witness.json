[
 {
  "name": "p2b doll: the hooks answer at rig 2 (the doll's state on the hero and the folk, lineup, camhold, dollpart off)",
  "params": {
   "rig": 2,
   "hour": 11,
   "god": true
  },
  "steps": [
   {
    "at": 0.1,
    "shot": "p2b_doll_t0_0.png"
   },
   {
    "at": 0.2,
    "expect": [
     "state.player.sprite.rig == 2",
     "typeof state.player.sprite.doll.covered == 'boolean'",
     "Array.isArray(state.player.sprite.doll.missing)",
     "state.player.sprite.doll.pool >= 0",
     "state.player.anim.gait == 'walk'"
    ]
   },
   {
    "at": 0.3,
    "call": [
     [
      "lineup",
      "heartland",
      "villager",
      4,
      "mixed"
     ],
     [
      "camhold",
      1
     ]
    ],
    "expect": [
     "entities.filter(e => e.id >= 910000 && e.id < 920000).length == 4",
     "entities.filter(e => e.id >= 910000 && e.id < 920000).every(e => e.doll && typeof e.doll.covered == 'boolean')"
    ]
   },
   {
    "at": 0.5,
    "shot": "p2b_doll_hooks.png"
   },
   {
    "at": 0.6,
    "call": [
     [
      "camhold",
      0
     ],
     [
      "dollpart",
      "off"
     ]
    ],
    "expect": "state.player.sprite.drawn"
   }
  ]
 },
 {
  "name": "p2b doll: a look the doll does not cover is drawn whole on v1 (never a half-made person)",
  "params": {
   "rig": 2,
   "hour": 11
  },
  "steps": [
   {
    "at": 0.7,
    "shot": "p2b_doll_t1_0.png"
   },
   {
    "at": 0.8,
    "expect": [
     "state.player.sprite.doll.covered || (state.player.sprite.drawn && state.player.sprite.boxH <= 24)",
     "state.player.sprite.doll.covered || state.player.sprite.doll.missing.length > 0"
    ]
   }
  ]
 },
 {
  "name": "p2b target (B6): the A3 hero is covered at rig 2: drawn by the doll, 32 px (34 with the cowlick), measured on idle frame 0 (STYLE_P2 3: the body box without the breathe frame's 1 px lift)",
  "params": {
   "rig": 2,
   "hour": 11,
   "god": true
  },
  "steps": [
   {
    "at": 0.2,
    "call": [
     [
      "skill",
      "kit",
      "sword",
      "none"
     ],
     [
      "hair",
      "short",
      "copper"
     ],
     [
      "pose",
      "idle",
      0,
      0
     ]
    ]
   },
   {
    "at": 0.5,
    "shot": "p2b_doll_hero.png"
   },
   {
    "at": 0.6,
    "expect": [
     "state.player.sprite.doll.covered",
     "state.player.sprite.boxH >= 32 && state.player.sprite.boxH <= 34"
    ]
   }
  ]
 },
 {
  "name": "p2b target (B6): the woman hero and the start village's civilians are covered (armour, helms, shields and culture weapons are P2c's: C1, and v1Draws 0 is C2)",
  "params": {
   "rig": 2,
   "hour": 11,
   "female": true
  },
  "steps": [
   {
    "at": 0.6,
    "expect": [
     "state.player.sprite.doll.covered",
     "entities.filter(e => e.kind == 'person' && e.doll).length >= 4",
     "entities.filter(e => e.kind == 'person' && e.doll && !e.doll.covered).every(e => /^(armour|helm|shield|pauldron|held|sheath)=/.test(e.doll.first || ''))"
    ],
    "shot": "p2b_doll_village.png"
   }
  ]
 },
 {
