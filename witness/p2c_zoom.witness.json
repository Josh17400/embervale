[
  { "name": "p2c zoom: an iPhone 15 Pro's first launch (2556x1179, FILL, the safe insets) starts at NEAR: D 6, the world 426 x 197",
    "params": { "window": [2556, 1179], "screen": "fill", "safe": [177, 0, 177, 63], "hour": 11 },
    "steps": [ { "at": 0.2, "call": ["firstlaunch", "phone"] },
               { "at": 0.4, "shot": "p2c_zoom_phone_first.png",
                 "expect": ["state.screen.zoom == 1", "state.screen.zoomName == 'NEAR'", "state.screen.world.d0 == 5",
                            "state.screen.world.want == 6", "state.screen.world.scale == 6 && state.screen.world.integer",
                            "state.screen.world.w == 426 && state.screen.world.h == 197"] } ] },
  { "name": "p2c zoom: Safari (2556x1020) at D 5, iPhone 11 (1792x828) and SE (1334x750) at D 4",
    "params": { "window": [2556, 1179], "screen": "fill", "hour": 11 },
    "steps": [ { "at": 0.2, "call": ["firstlaunch", "phone", "2556x1020"] },
               { "at": 0.4, "expect": ["state.screen.zoom == 1", "state.screen.world.want == 5", "state.screen.world.scale == 5"] },
               { "at": 0.5, "call": ["firstlaunch", "phone", "1792x828"] },
               { "at": 0.7, "expect": ["state.screen.zoom == 1", "state.screen.world.want == 4", "state.screen.world.scale == 4"] },
               { "at": 0.8, "call": ["firstlaunch", "phone", "1334x750"] },
               { "at": 1.0, "expect": ["state.screen.zoom == 1", "state.screen.world.want == 4", "state.screen.world.scale == 4"] } ] },
  { "name": "p2c zoom: a desktop's first launch (1440x810) stays NORMAL at D 3; an iPad (2360x1640) stays NORMAL at D 7",
    "params": { "window": [1440, 810], "screen": "pixel", "hour": 11 },
    "steps": [ { "at": 0.2, "call": ["firstlaunch", "desktop"] },
               { "at": 0.4, "expect": ["state.screen.zoom == 0", "state.screen.world.want == 3", "state.screen.world.scale == 3"] },
               { "at": 0.5, "call": ["firstlaunch", "tablet", "2360x1640"] },
               { "at": 0.7, "expect": ["state.screen.zoom == 0", "state.screen.world.d0 == 7", "state.screen.world.want == 7"] } ] },
  { "name": "p2c zoom: a phone's saved FAR is kept on the next launch",
    "params": { "window": [2556, 1179], "screen": "fill", "hour": 11 },
    "steps": [ { "at": 0.2, "call": [["firstlaunch", "phone"], ["zoom", "far"], ["relaunch", "phone"]] },
               { "at": 0.4, "expect": ["state.screen.zoom == -1", "state.screen.world.want == 4", "state.screen.world.scale == 4"] } ] },
  { "name": "p2c zoom: a Witness reset after a launch is NORMAL again (the harness's zoom wins)",
    "params": { "window": [2556, 1179], "screen": "fill", "hour": 11 },
    "steps": [ { "at": 0.3, "expect": ["state.screen.zoom == 0", "state.screen.world.want == 5"] } ] }
]
