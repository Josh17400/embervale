[
  { "name": "P5 PACK: at seed 7's start town (a River town) the hero buys the smith's 48-gold leather coat and wears it: the worn coat's maker is the River people (its fingerprint), the T1 floor before it had none",
    "seed": 7, "params": { "god": true, "hour": 11 },
    "steps": [ { "at": 0.3, "expect": ["state.mode == 'play'", "!state.player.equipped.armor"] },
               { "at": 0.4, "call": [["rig", "2"], ["expect", "makers", "body", "none"], ["expect", "culture", "river"], ["gold", "60"]] },
               { "at": 0.5, "call": [["enter", "smithy"], ["walkto", "smith", "20"]] },
               { "at": 30.0, "expect": ["!state.script.busy", "state.player.inside"] },
               { "at": 30.1, "call": ["shopat", "smith"], "expect": "state.mode == 'shop'" },
               { "at": 30.2, "call": [["expect", "shopprice", "LEATHER", "GAMBESON", "==", "48"]] },
               { "at": 30.3, "call": [["p4row", "shop", "LEATHER", "GAMBESON"], ["key", "Return"]] },
               { "at": 30.8, "expect": ["state.player.equipped.armor == 'LEATHER GAMBESON'", "state.player.gold == 12"] },
               { "at": 30.9, "call": [["key", "Escape"]] },
               { "at": 31.2, "call": [["expect", "makers", "body", "river"], ["expect", "makers", "helm", "none"]],
                 "expect": ["state.mode == 'play'", "state.script.fails == 0"] } ] },
  { "name": "P5 PACK: a companion given a Fjordfolk mail shirt, a Steppe leather cap and Marsh leather boots wears three peoples' makers, one per piece",
    "seed": 7, "params": { "god": true, "hour": 11 },
    "steps": [ { "at": 0.3, "call": [["rig", "2"], ["party", "recruit"]] },
               { "at": 0.5, "call": [["gear6", "armor", "ilvl", "5", "rarity", "2", "fjordfolk", "mat", "iron"], ["party", "give", "1"]] },
               { "at": 0.6, "call": [["gear6", "helmet", "ilvl", "5", "rarity", "4", "steppe", "mat", "leather"], ["party", "give", "1"]] },
               { "at": 0.7, "call": [["gear6", "boots", "ilvl", "5", "rarity", "4", "marsh", "mat", "leather"], ["party", "give", "1"]] },
               { "at": 1.0, "call": [["expect", "makers", "body", "fjordfolk", "companion", "0"], ["expect", "makers", "helm", "steppe", "companion", "0"],
                                     ["expect", "makers", "boots", "marsh", "companion", "0"]],
                 "expect": ["state.script.fails == 0"] } ] }
