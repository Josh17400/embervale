[
  { "name": "walking east moves the player",
    "input": "d@0.2-2.2",
    "steps": [ { "at": 1, "expect": ["state.mode == 'play'", "state.player.state == 'walk'"] },
               { "at": 2.5, "expect": ["state.player.moved >= 4", "state.player.state == 'idle'"] } ] },
  { "name": "the start village has people about",
    "steps": [ { "at": 1, "expect": ["entities.filter(e => e.kind == 'person').length >= 3", "state.location.region != ''"] } ] },
  { "name": "fast travel into a town",
    "scene": "town",
    "steps": [ { "at": 1, "expect": ["state.location.siteType == 'TOWN'", "entities.filter(e => e.kind == 'person').length >= 5"], "shot": "town.png" } ] },
  { "name": "a wolf fight costs the wolves hp and earns xp",
    "seed": 2, "scene": "cave", "params": { "god": true, "fight": "wolf", "count": 2, "hour": 10 },
    "input": "j@0.4-14",
    "steps": [ { "at": 0.3, "expect": ["count('Wolf') == 2", "state.player.xp == 0"] },
               { "at": 4, "expect": "all('Wolf').some(w => w.hp < w.maxHp)" },
               { "at": 14, "expect": ["state.player.kills >= 1", "state.player.xp > 0"] } ] },
  { "name": "dialogue, a quest and its completion through calls",
    "seed": 8, "params": { "god": true, "hour": 10 },
    "steps": [ { "at": 0.2, "call": ["talkto", "giver", 40], "expect": "state.script.busy" },
               { "at": 15, "expect": ["state.mode == 'dialogue'", "!state.script.busy", "state.dialogue.options.length > 1"] },
               { "at": 15.2, "call": ["key", "Escape"] },
               { "at": 15.5, "call": [["givequest", "hunt", "wolf", 1], ["gotosite", "start"], ["fightquest"]],
                 "expect": ["state.mode == 'play'", "state.quests.some(q => q.title == 'THE HUNT' && q.state == 'active' && q.tracked)"] },
               { "at": 15.6, "input": "j@0-20" },
               { "at": 36, "expect": ["state.quests.some(q => q.title == 'THE HUNT' && q.state == 'complete')"] },
               { "at": 70, "call": ["talkto", "giver", 90] },
               { "at": 110, "expect": ["state.mode == 'dialogue'", "state.dialogue.options.some(o => o.includes('COLLECT'))"] },
               { "at": 110.1, "call": ["choose", "COLLECT"],
                 "expect": ["state.quests.some(q => q.title == 'THE HUNT' && q.state == 'done')", "state.player.xp >= 50", "state.script.fails == 0"] } ] },
  { "name": "time passing moves the clock",
    "params": { "hour": 8 },
    "steps": [ { "at": 0.1, "expect": "approx(state.hour, 8, 0.05)" },
               { "at": 30, "expect": ["state.hour > 8.2", "state.day == 1"] } ] },
  { "name": "a witness run never writes the save",
    "input": "d@1-3, escape@4",
    "steps": [ { "at": 25, "expect": ["state.save.enabled == false", "state.save.written == 0"] } ] },
  { "name": "the same seed gives the same world",
    "seed": 7,
    "steps": [ { "at": 0.1, "expect": ["JSON.stringify(state.player.start) == '[-165,-431]'", "state.location.site == 'OSLARS'", "state.location.kingdom == 'VONTVE'"] } ] }
]
