[
  { "name": "P4 ECONOMY: a newcomer with 30 gold hunts a few beasts, sells the hides and pelts at the smith and buys and wears the 48-gold leather coat",
    "seed": 7, "params": { "god": true, "hour": 11 },
    "steps": [ { "at": 0.3, "expect": ["state.mode == 'play'", "state.player.gold == 30", "!state.player.equipped.armor"] },
               { "at": 0.4, "call": [["skill", "foe", "wolf", "1", "0", "level", "1"], ["skill", "foe", "wolf", "-1", "0", "level", "1"],
                                      ["skill", "foe", "boar", "0", "1", "level", "1"], ["skill", "foe", "boar", "0", "-1", "level", "1"]] },
               { "at": 0.6, "call": ["killnear", "3"] },
               { "at": 3.0, "call": [["skill", "foe", "wolf", "1", "0", "level", "1"], ["skill", "foe", "wolf", "-1", "0", "level", "1"],
                                      ["skill", "foe", "boar", "0", "1", "level", "1"], ["skill", "foe", "boar", "0", "-1", "level", "1"]] },
               { "at": 3.2, "call": ["killnear", "3"] },
               { "at": 5.6, "call": [["skill", "foe", "wolf", "1", "0", "level", "1"], ["skill", "foe", "wolf", "-1", "0", "level", "1"],
                                      ["skill", "foe", "boar", "0", "1", "level", "1"], ["skill", "foe", "boar", "0", "-1", "level", "1"]] },
               { "at": 5.8, "call": ["killnear", "3"] },
               { "at": 8.2, "call": [["skill", "foe", "wolf", "1", "0", "level", "1"], ["skill", "foe", "wolf", "-1", "0", "level", "1"],
                                      ["skill", "foe", "boar", "0", "1", "level", "1"], ["skill", "foe", "boar", "0", "-1", "level", "1"]] },
               { "at": 8.4, "call": ["killnear", "3"] },
               { "at": 11.0, "expect": ["state.player.gold == 30", "state.player.items >= 4"] },
               { "at": 11.1, "call": [["enter", "smithy"], ["walkto", "smith", "20"]] },
               { "at": 40.0, "expect": ["!state.script.busy", "state.player.inside"] },
               { "at": 40.1, "call": ["shopat", "smith"], "expect": "state.mode == 'shop'" },
               { "at": 40.2, "call": [["expect", "shopprice", "LEATHER", "GAMBESON", "==", "48"], ["expect", "shopprice", "BRONZE", "BRIGANDINE", "==", "80"]] },
               { "at": 40.3, "call": [["p4sell", "PELT"], ["p4sell", "HIDE"], ["p4sell", "VENISON"]], "expect": "state.player.gold >= 48" },
               { "at": 40.5, "call": [["p4row", "shop", "LEATHER", "GAMBESON"], ["key", "Return"]] },
               { "at": 41.0, "expect": ["state.player.equipped.armor == 'LEATHER GAMBESON'", "state.player.gold >= 0", "state.script.fails == 0"] } ] }
]
