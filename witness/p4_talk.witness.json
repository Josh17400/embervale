[
  { "name": "p4 talk: seed 7, the wolves taken from the innkeeper are the tracked quest (the goal line and the first Quest thing)",
    "seed": 7, "params": { "god": true, "hour": 10 },
    "steps": [ { "at": 0.2, "call": ["enter", "inn"] },
               { "at": 1.0, "call": ["talkto", "innkeeper"] },
               { "at": 8, "expect": ["state.mode == 'dialogue'", "state.dialogue.options.some(o => o.includes('ANY WORK GOING'))"] },
               { "at": 8.1, "call": ["choose", "ANY WORK GOING"] },
               { "at": 11, "expect": ["state.mode == 'dialogue'", "state.dialogue.options.some(o => o.includes(\"I'LL DO IT\"))"] },
               { "at": 11.1, "call": ["choose", "I'LL DO IT"] },
               { "at": 12, "call": ["key", "Escape"] },
               { "at": 12.5, "expect": ["state.mode == 'play'", "state.goal !== null && state.goal.text.startsWith('THE WOLVES OF OSLARS')"] },
               { "at": 12.6, "call": ["home", "leave"] },
               { "at": 14, "expect": ["state.mode == 'play'", "state.goal !== null && state.goal.text.startsWith('THE WOLVES OF OSLARS')",
                                      "entities.filter(e => e.type == 'Quest').length >= 1 && entities.filter(e => e.type == 'Quest')[0].name == 'THE WOLVES OF OSLARS'",
                                      "state.quests.some(q => q.title == 'THE WOLVES OF OSLARS' && q.tracked)", "state.script.fails == 0"] } ] },
  { "name": "p4 talk: GAOLD's shared options keep their index with and without bread",
    "seed": 7, "params": { "god": true, "hour": 10 },
    "steps": [ { "at": 0.2, "call": [["enter", "smithy"], ["p4food", "give"]] },
               { "at": 1.0, "call": ["talkto", "smith"] },
               { "at": 8, "expect": ["state.mode == 'dialogue'", "state.dialogue.speaker.includes('GAOLD')",
                                     "state.dialogue.options[0].includes('WHAT CAN YOU OFFER')",
                                     "state.dialogue.options[1].includes('HOW ARE YOU KEEPING')",
                                     "state.dialogue.options[state.dialogue.options.length - 1].includes('FAREWELL')"] },
               { "at": 8.1, "call": [["key", "Escape"], ["p4food", "drop"]] },
               { "at": 9.0, "call": ["talkto", "smith"] },
               { "at": 16, "expect": ["state.mode == 'dialogue'", "state.dialogue.speaker.includes('GAOLD')",
                                      "state.dialogue.options[0].includes('WHAT CAN YOU OFFER')",
                                      "state.dialogue.options[1].includes('HOW ARE YOU KEEPING')",
                                      "state.dialogue.options[state.dialogue.options.length - 1].includes('FAREWELL')",
                                      "state.script.fails == 0"] } ] }
]
