  { "name": "p2a lens: the zoom keys: = steps in, - steps out, only through the levels the screen allows",
    "params": { "window": [1920, 1080], "screen": "pixel", "hour": 11 },
    "steps": [ { "at": 0.2, "expect": "state.screen.zoom == 0 && state.screen.world.want == 5" },
               { "at": 0.3, "input": "equals@0-0.1" },
               { "at": 0.6, "expect": ["state.screen.zoom == 1", "state.screen.world.want == 6"] },
               { "at": 0.7, "input": "equals@0-0.1" },
               { "at": 1.0, "input": "equals@0-0.1" },
               { "at": 1.3, "expect": ["state.screen.zoom == 2", "state.screen.world.want == 7"] },
               { "at": 1.4, "input": "minus@0-0.1" },
               { "at": 1.6, "input": "minus@0-0.1" },
               { "at": 1.8, "input": "minus@0-0.1" },
               { "at": 2.0, "input": "minus@0-0.1" },
               { "at": 2.3, "expect": ["state.screen.zoom == -1", "state.screen.world.want == 4"] } ] },
  { "name": "p2a lens: ZOOM is set (the zoom call) ...",
    "params": { "window": [1440, 810], "screen": "pixel" },
    "steps": [ { "at": 0.2, "call": ["zoom", "near"], "expect": ["state.screen.zoom == 1"] } ] },
  { "name": "p2a lens: ... and survives a reset as it survives a restart (zoom 'keep': the settings file's value)",
    "params": { "window": [1440, 810], "screen": "pixel", "zoom": "keep" },
    "steps": [ { "at": 0.2, "expect": ["state.screen.zoom == 1", "state.screen.zoomName == 'NEAR'", "state.screen.world.want == 4"] } ] },
  { "name": "p2a lens: the rig and the body: rig 2 and a woman report the v2 metrics; the pose call freezes the hero's frame",
    "params": { "rig": 2, "female": true, "hour": 11 },
    "steps": [ { "at": 0.2, "expect": ["state.player.sprite.rig == 2", "state.player.sprite.figH == 31"] },
               { "at": 0.3, "call": ["pose", "strike", "sword", 1, 0],
                 "expect": ["state.player.anim.clip == 'strike'", "state.player.anim.family == 'sword'", "state.player.anim.variant == 1", "state.player.anim.frozen"] },
               { "at": 0.4, "call": ["pose", "off"], "expect": ["state.player.anim.clip == 'idle'", "!state.player.anim.frozen"] } ] },
  { "name": "p2a lens: the PLAYER RING setting and the hooks (ring, ui, hideplayer) answer",
    "params": { "hour": 11 },
    "steps": [ { "at": 0.2, "expect": "state.screen.ring" },
               { "at": 0.3, "call": ["ring", 0], "expect": "!state.screen.ring" },
               { "at": 0.4, "call": [["ring"], ["ui", 0], ["hideplayer", 1]], "expect": "state.screen.ring" },
               { "at": 0.5, "shot": "p2a_lens_hooks.png" },
